    @property
    def closed(self) -> bool: ...
    @property
    def authenticated(self) -> bool: ...
    def order_books(self, *, market_id: int | None = None) -> Awaitable[Native]: ...
    def order_book_orders(self, market_id: int, *, limit: int = 50) -> Awaitable[Native]: ...
    def recent_trades(self, market_id: int, *, limit: int = 50) -> Awaitable[Native]: ...
    def account(self, *, account_index: int | None = None,
                 l1_address: str | None = None) -> Awaitable[Native]: ...
    def next_nonce(self, account_index: int, api_key_index: int) -> Awaitable[Native]: ...
