{
  "name": "aux-connectors",
  "version": "0.0.4",
  "repository": { "type": "git", "url": "git+https://github.com/polaris-data/aux.git", "directory": "sdk/typescript" },
  "description": "TypeScript SDK for the aux Zig core",
  "engines": { "node": ">=22" },
  "main": "./js/index.cjs",
  "types": "./js/index.d.ts",
  "exports": { ".": { "types": "./js/index.d.ts", "import": "./js/index.mjs", "require": "./js/index.cjs" } },
  "files": ["js", "aux.*.node", "LICENSE", "NOTICE"],
  "scripts": { "build": "napi build --release --platform --js native.cjs --dts native.d.ts -- --locked" },
  "devDependencies": { "@napi-rs/cli": "3.5.1", "typescript": "5.9.3" },
  "napi": { "binaryName": "aux", "targets": ["aarch64-apple-darwin", "x86_64-apple-darwin", "x86_64-unknown-linux-gnu"] }
}
