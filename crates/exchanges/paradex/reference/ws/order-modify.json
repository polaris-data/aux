          "name": "subscribe",
          "title": "subscribe",
          "payload": {
            "$ref": "#/components/schemas/OrderModifySubscribe"
          }
        }
      },
      "subscribe": {
        "operationId": "order-modify-subscribe",
        "summary": "publish",
        "description": "Updates the price and/or size of an open order. A new Starknet signature over the updated order payload is required.",
        "message": {
          "name": "publish",
          "title": "publish",
          "description": "Updates the price and/or size of an open order. A new Starknet signature over the updated order payload is required.",
          "payload": {
            "$ref": "#/components/schemas/OrderModifyPublish"
          }
        }
      }
    }
  },
  "servers": {
    "production": {
      "url": "wss://ws.api.prod.paradex.trade/v1?sbeSchemaId=1&sbeSchemaVersion=1",
      "protocol": "wss",
      "x-default": true
    }
  },
