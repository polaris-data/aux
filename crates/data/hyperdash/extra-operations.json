{
  "getMe": {
    "path": "/v1/me",
    "auth": true,
    "response": {
      "type": "object",
      "properties": {
        "scopes": {"type": "array", "items": {"type": "string"}},
        "credits": {
          "type": ["object", "null"],
          "properties": {
            "included": {"type": "integer"},
            "used": {"type": "integer"},
            "reserved": {"type": "integer"},
            "topup_balance": {"type": "integer"},
            "remaining": {"type": "integer"},
            "low": {"type": "boolean"}
          }
        }
      }
    }
  },
  "getQuote": {
    "path": "/v1/quote",
    "auth": true,
    "parameters": [
      {"name": "route", "in": "query", "required": true, "schema": {"type": "string"}},
      {"name": "range_ms", "in": "query", "schema": {"type": "integer"}}
    ],
    "extra_query": true,
    "response": {
      "type": "object",
      "required": ["max_credits", "price_version"],
      "properties": {
        "max_credits": {"type": "integer"},
        "price_version": {"type": "integer"}
      }
    }
  },
  "getDatasets": {
    "path": "/v1/datasets",
    "response": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "description": {"type": "string"},
              "status": {"type": "string"},
              "coverage_start": {"type": ["string", "null"]},
              "freshness": {"type": ["string", "null"]},
              "gaps": {"type": "array", "items": {}},
              "history_entitlement": {"type": ["string", "null"]},
              "endpoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "route": {"type": "string"},
                    "summary": {"type": "string"},
                    "scope": {"type": "string"},
                    "max_range_ms": {"type": ["integer", "null"]},
                    "max_limit": {"type": ["integer", "null"]},
                    "pricing": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "getStatus": {
    "path": "/v1/status",
    "response": {
      "type": "object",
      "required": ["as_of", "datasets"],
      "properties": {
        "as_of": {"type": "integer"},
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "complete_to": {"type": ["integer", "null"]},
              "lag_ms": {"type": ["integer", "null"]},
              "health": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "getChangelog": {
    "path": "/v1/changelog",
    "parameters": [{"name": "since", "in": "query", "schema": {"type": "integer"}}],
    "response": {
      "type": "object",
      "required": ["data"],
      "properties": {"data": {"type": "array", "items": {"type": "object"}}}
    }
  }
}
