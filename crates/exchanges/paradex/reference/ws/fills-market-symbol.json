{
  "asyncapi": "2.6.0",
  "info": {
    "title": "fills.{market_symbol}",
    "version": "subpackage_fillsMarketSymbol.fillsMarketSymbol"
  },
  "channels": {
    "/fills.{market_symbol}": {
      "parameters": {
        "market_symbol": {
          "description": "Symbol of the market (e.g., BTC-PERP)",
          "schema": {
            "type": "string"
          }
        }
      },
      "publish": {
        "operationId": "fills-market-symbol-publish",
        "summary": "subscribe",
        "message": {
          "name": "subscribe",
          "title": "subscribe",
          "payload": {
            "$ref": "#/components/schemas/FillsMarketSymbolSubscribe"
          }
        }
      }
    }
  },
  "servers": {
    "production": {
      "url": "wss://ws.api.prod.paradex.trade/v1?sbeSchemaId=1&sbeSchemaVersion=1",
      "protocol": "wss",
      "x-default": true
    }
  },
  "components": {
    "schemas": {
      "ChannelsFillsMarketSymbolSubscribeFillType": {
        "type": "string",
        "enum": [
          "LIQUIDATION",
          "UNWIND_TRANSFER",
          "FILL",
          "SETTLE_MARKET",
          "RPI",
          "BLOCK_TRADE"
        ],
        "description": "Fill type, can be FILL, LIQUIDATION or UNWIND_TRANSFER",
        "title": "ChannelsFillsMarketSymbolSubscribeFillType"
      },
      "ChannelsFillsMarketSymbolSubscribeLiquidity": {
        "type": "string",
        "enum": [
          "TAKER",
          "MAKER"
        ],
        "description": "Maker or Taker",
        "title": "ChannelsFillsMarketSymbolSubscribeLiquidity"
      },
      "ChannelsFillsMarketSymbolSubscribeSide": {
        "type": "string",
        "enum": [
          "BUY",
          "SELL"
        ],
        "description": "Taker side",
        "title": "ChannelsFillsMarketSymbolSubscribeSide"
      },
      "FillsMarketSymbolSubscribe": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "description": "Account that made the fill"
          },
          "client_id": {
            "type": "string",
            "description": "Unique client assigned ID for the order"
          },
          "created_at": {
            "type": "integer",
            "description": "Fill time"
          },
          "fee": {
            "type": "string",
            "description": "Fee paid by the user"
          },
          "fee_currency": {
            "type": "string",
            "description": "Asset that fee is charged in"
          },
          "fill_type": {
            "$ref": "#/components/schemas/ChannelsFillsMarketSymbolSubscribeFillType",
            "description": "Fill type, can be FILL, LIQUIDATION or UNWIND_TRANSFER"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fill flags indicating special properties"
          },
          "id": {
            "type": "string",
            "description": "Unique string ID of fill per FillType"
          },
          "leverage": {
            "type": "string",
            "description": "Leverage of the account's position when the fill was processed; omitted for spot, options, liquidations and fills before it was recorded. Delivered on the JSON encoding only, not the SBE binary encoding."
          },
          "liquidity": {
            "$ref": "#/components/schemas/ChannelsFillsMarketSymbolSubscribeLiquidity",
            "description": "Maker or Taker"
          },
          "market": {
            "type": "string",
            "description": "Market name"
          },
          "order_id": {
            "type": "string",
            "description": "Order ID"
          },
          "orderbook_seq_no": {
            "type": "integer",
            "description": "Orderbook sequence number after trade execution (post-execution state). Use seqno-1 for pre-execution. 0 for position transfers (liquidations, settlements)"
          },
          "price": {
            "type": "string",
            "description": "Price at which order was filled"
          },
          "realized_funding": {
            "type": "string",
            "description": "Realized funding of the fill"
          },
          "realized_pnl": {
            "type": "string",
            "description": "Realized PnL of the fill"
          },
          "remaining_size": {
            "type": "string",
            "description": "Remaining size of the order"
          },
          "side": {
            "$ref": "#/components/schemas/ChannelsFillsMarketSymbolSubscribeSide",
            "description": "Taker side"
          },
          "size": {
            "type": "string",
            "description": "Size of the fill"
          },
          "underlying_price": {
            "type": "string",
            "description": "Underlying asset price of the fill (spot price)"
          }
        },
        "required": [
          "account",
          "client_id",
          "created_at",
          "fee",
          "fee_currency",
          "fill_type",
          "flags",
          "id",
          "liquidity",
          "market",
          "order_id",
          "price",
          "realized_funding",
          "realized_pnl",
          "remaining_size",
          "side",
          "size",
          "underlying_price"
        ],
        "title": "FillsMarketSymbolSubscribe"
      }
    }
  }
}
