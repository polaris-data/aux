          },
          "size": {
            "type": "string",
            "description": "Order size"
          },
          "status": {
            "$ref": "#/components/schemas/ChannelsOrderModifySubscribeOrderStatus",
            "description": "Order status"
          },
          "timestamp": {
            "type": "integer",
            "description": "Signature timestamp supplied at creation"
          },
          "trigger_price": {
            "type": "string",
            "description": "Trigger price for stop orders"
          },
          "type": {
            "$ref": "#/components/schemas/ChannelsOrderModifySubscribeOrderType",
            "description": "Order type"
          }
        },
        "description": "Modified order",
        "title": "ChannelsOrderModifySubscribeOrder"
