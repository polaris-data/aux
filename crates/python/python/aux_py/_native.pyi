from typing import Any, Awaitable, Callable

__version__: str
Native = dict[str, Any]

class ConnectorError(Exception): ...
class ValidationError(ConnectorError): ...
class ClosedError(ConnectorError): ...
class BusyError(ConnectorError): ...
class DecodeError(ConnectorError): ...
class AuthenticationError(ConnectorError): ...
class SigningError(ConnectorError): ...
class NonceUncertainError(ConnectorError): ...
class TransportError(ConnectorError):
    kind: str
    outcome: str
class GapError(TransportError): ...
class ExchangeError(ConnectorError):
    venue: str
    http_status: int | None
    body: str | None
    native_message: str | None
    code: int | None
    extra: Native

class HyperliquidSigningPayload:
    @property
    def digest(self) -> bytes: ...
    @property
    def network(self) -> str: ...
    @property
    def scheme(self) -> str: ...
    def recover_address(self, signature: Native) -> str: ...

class LighterSigningPayload:
    @property
    def digest(self) -> bytes: ...
    @property
    def chain_id(self) -> int: ...
    @property
    def account_index(self) -> int: ...
    @property
    def api_key_index(self) -> int: ...
    @property
    def purpose(self) -> Native: ...
    def verify(self, signature: str, public_key: str) -> bool: ...

class HyperliquidSigner:
    def __init__(self, private_key: str) -> None: ...
    @staticmethod
    def remote(address: str, callback: Callable[[HyperliquidSigningPayload], Awaitable[Native]]) -> HyperliquidSigner: ...
    @property
    def address(self) -> str: ...
    def sign(self, payload: HyperliquidSigningPayload) -> Awaitable[Native]: ...
    def sign_action(self, action: Native, *, nonce: int, network: str = "testnet",
                    vault_address: str | None = None, expires_after: int | None = None) -> Awaitable[Native]: ...
    def sign_user_action(self, action: Native, *, network: str = "testnet",
                         signature_chain_id: int = 421_614) -> Awaitable[Native]: ...

class LighterSigner:
    def __init__(self, private_key: str) -> None: ...
    @staticmethod
    def remote(public_key: str, callback: Callable[[LighterSigningPayload], Awaitable[str]]) -> LighterSigner: ...
    @property
    def public_key(self) -> str: ...
    def sign(self, payload: LighterSigningPayload) -> Awaitable[str]: ...
    def sign_transaction(self, kind: str, request: Native, *, account_index: int,
                         api_key_index: int, nonce: int, network: str = "testnet",
                         chain_id: int | None = None, expired_at: int | None = None,
                         attributes: dict[int, int] | None = None) -> Awaitable[Native]: ...
    def auth_token(self, *, account_index: int, api_key_index: int, deadline: int,
                   network: str = "testnet", chain_id: int | None = None) -> Awaitable[str]: ...

def hyperliquid_action_hash(action: Native, *, nonce: int, vault_address: str | None = None,
                            expires_after: int | None = None) -> str: ...
def hyperliquid_signing_payload(action: Native, *, nonce: int, network: str = "testnet",
                                vault_address: str | None = None, expires_after: int | None = None) -> HyperliquidSigningPayload: ...
def hyperliquid_user_signing_payload(action: Native, *, network: str = "testnet",
                                     signature_chain_id: int = 421_614) -> HyperliquidSigningPayload: ...
def lighter_auth_signing_payload(*, account_index: int, api_key_index: int, deadline: int,
                                 network: str = "testnet", chain_id: int | None = None) -> LighterSigningPayload: ...
def lighter_transaction_signing_payload(kind: str, request: Native, *, account_index: int,
                                       api_key_index: int, nonce: int, network: str = "testnet",
                                       chain_id: int | None = None, expired_at: int | None = None,
                                       attributes: dict[int, int] | None = None) -> LighterSigningPayload: ...
def validate_hyperliquid_order(order: Native, *, sz_decimals: int, is_spot: bool = False) -> None: ...
def scale_lighter_decimal(value: str, decimals: int) -> int: ...

class HyperliquidClient:
    def __init__(self, *, network: str = "testnet", http_url: str | None = None,
                 ws_url: str | None = None, timeout_ms: int = 10_000,
                 subscription_capacity: int = 128, signer: HyperliquidSigner | None = None,
                 account_address: str | None = None, vault_address: str | None = None,
                 read_retries: int = 2, reconnect_retries: int = 3,
                 initial_backoff_ms: int = 100, max_backoff_ms: int = 2000,
                 heartbeat_interval_ms: int = 20_000, idle_timeout_ms: int = 60_000,
                 max_message_bytes: int = 8_388_608, reconnect_stable_ms: int = 30_000) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def authenticated(self) -> bool: ...
    @property
    def signer_address(self) -> str | None: ...
    @property
    def account_address(self) -> str | None: ...
    def meta(self, *, dex: str | None = None) -> Awaitable[Native]: ...
    def l2_book(self, coin: str, *, n_sig_figs: int | None = None,
                mantissa: int | None = None) -> Awaitable[Native]: ...
    def clearinghouse_state(self, user: str, *, dex: str | None = None) -> Awaitable[Native]: ...
    def open_orders(self, user: str, *, dex: str | None = None) -> Awaitable[list[Native]]: ...
    def order(self, request: Native, *, nonce: int | None = None,
               expires_after: int | None = None) -> Awaitable[Native]: ...
    def cancel(self, request: Native, *, nonce: int | None = None,
               expires_after: int | None = None) -> Awaitable[Native]: ...
    def cancel_by_cloid(self, request: Native, *, nonce: int | None = None,
                        expires_after: int | None = None) -> Awaitable[Native]: ...
    def subscribe(self, spec: Native) -> Awaitable[Subscription]: ...
    def subscribe_l2_book(self, coin: str) -> Awaitable[Subscription]: ...
    def aclose(self) -> Awaitable[None]: ...

class LighterClient:
    def __init__(self, *, network: str = "testnet", http_url: str | None = None,
                 ws_url: str | None = None, chain_id: int | None = None,
                 timeout_ms: int = 10_000, subscription_capacity: int = 128,
