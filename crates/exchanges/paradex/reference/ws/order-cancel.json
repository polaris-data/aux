          "payload": {
            "$ref": "#/components/schemas/OrderCancelPublish"
          }
        }
      }
    }
  },
  "servers": {
    "production": {
      "url": "wss://ws.api.prod.paradex.trade/v1?sbeSchemaId=1&sbeSchemaVersion=1",
      "protocol": "wss",
