    def create_order(self, request: Native, *, expired_at: int | None = None,
                      attributes: dict[int, int] | None = None) -> Awaitable[Native]: ...
    def cancel_order(self, request: Native, *, expired_at: int | None = None,
                      attributes: dict[int, int] | None = None) -> Awaitable[Native]: ...
