{
  "asyncapi": "2.6.0",
  "info": {
    "title": "positions",
    "version": "subpackage_positions.positions"
  },
  "channels": {
    "/positions": {
      "publish": {
        "operationId": "positions-publish",
        "summary": "subscribe",
        "message": {
          "name": "subscribe",
          "title": "subscribe",
          "payload": {
            "$ref": "#/components/schemas/PositionsSubscribe"
          }
        }
      }
    }
  },
  "servers": {
    "production": {
      "url": "wss://ws.api.prod.paradex.trade/v1?sbeSchemaId=1&sbeSchemaVersion=1",
      "protocol": "wss",
      "x-default": true
    }
  },
  "components": {
    "schemas": {
      "ChannelsPositionsSubscribeSide": {
        "type": "string",
        "enum": [
          "SHORT",
          "LONG"
        ],
        "description": "Position Side : Long or Short",
        "title": "ChannelsPositionsSubscribeSide"
      },
      "ChannelsPositionsSubscribeStatus": {
        "type": "string",
        "enum": [
          "OPEN",
          "CLOSED"
        ],
        "description": "Status of Position : Open or Closed",
        "title": "ChannelsPositionsSubscribeStatus"
      },
      "PositionsSubscribe": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "description": "Account ID of the position"
          },
          "average_entry_price": {
            "type": "string",
            "description": "Average entry price"
          },
          "average_entry_price_usd": {
            "type": "string",
            "description": "Average entry price in USD"
          },
          "average_exit_price": {
            "type": "string",
            "description": "Average exit price"
          },
          "cached_funding_index": {
            "type": "string",
            "description": "Position cached funding index"
          },
          "closed_at": {
            "type": "integer",
            "description": "Position closed time"
          },
          "cost": {
            "type": "string",
            "description": "Position cost"
          },
          "cost_usd": {
            "type": "string",
            "description": "Position cost in USD"
          },
          "created_at": {
            "type": "integer",
            "description": "Position creation time"
          },
          "id": {
            "type": "string",
            "description": "Unique string ID for the position"
          },
          "last_fill_id": {
            "type": "string",
            "description": "Last fill ID to which the position is referring"
          },
          "last_updated_at": {
            "type": "integer",
            "description": "Position last update time"
          },
          "leverage": {
            "type": "string",
            "description": "Leverage of the position"
          },
          "liquidation_price": {
            "type": "string",
            "description": "Liquidation price of the position"
          },
          "market": {
            "type": "string",
            "description": "Market for position"
          },
          "realized_positional_funding_pnl": {
            "type": "string",
            "description": "Realized Funding PnL for the position. Reset to 0 when position is closed or flipped."
          },
          "realized_positional_pnl": {
            "type": "string",
            "description": "Realized PnL including both positional PnL and funding payments. Reset to 0 when position is closed or flipped."
          },
          "seq_no": {
            "type": "integer",
            "description": "Unique increasing number (non-sequential) that is assigned to this position update. Can be used to deduplicate multiple feeds"
          },
          "side": {
            "$ref": "#/components/schemas/ChannelsPositionsSubscribeSide",
            "description": "Position Side : Long or Short"
          },
          "size": {
            "type": "string",
            "description": "Size of the position with sign (positive if long or negative if short)"
          },
          "status": {
            "$ref": "#/components/schemas/ChannelsPositionsSubscribeStatus",
            "description": "Status of Position : Open or Closed"
          },
          "unrealized_funding_pnl": {
            "type": "string",
            "description": "Unrealized running funding P&L for the position"
          },
          "unrealized_pnl": {
            "type": "string",
            "description": "Unrealized P&L of the position in the quote asset. Includes the unrealized running funding P&L."
          }
        },
        "required": [
          "account",
          "average_entry_price",
          "average_entry_price_usd",
          "average_exit_price",
          "cached_funding_index",
          "cost",
          "cost_usd",
          "id",
          "last_fill_id",
          "leverage",
          "liquidation_price",
          "market",
          "realized_positional_funding_pnl",
          "realized_positional_pnl",
          "seq_no",
          "side",
          "size",
          "status",
          "unrealized_funding_pnl",
          "unrealized_pnl"
        ],
        "title": "PositionsSubscribe"
      }
    }
  }
}
