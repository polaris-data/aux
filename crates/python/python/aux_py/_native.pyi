class Subscription:
    @property
    def closed(self) -> bool: ...
    def next(self) -> Awaitable[Native]: ...
    def aclose(self) -> Awaitable[None]: ...

BookSubscription = Subscription


class OutcomeUncertainError(ConnectorError): ...

class ArcusSigner:
    def __init__(self, seed: str) -> None: ...
